        <mxCell id="9" parent="1" vertex="1" value="&lt;b&gt;4번 묶음&lt;/b&gt;&lt;br&gt;조합 선택에 사용" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Apple SD Gothic Neo;fontSize=22;fontStyle=0;fontColor=#172b4d;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=2;spacing=12;">
