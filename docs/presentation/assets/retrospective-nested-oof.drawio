        <mxCell id="3" parent="1" vertex="1" value="nested OOF: 조합을 고를 때도 확인용 정답은 남겨 둡니다" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Apple SD Gothic Neo;fontSize=34;fontStyle=1;fontColor=#172b4d;fillColor=none;strokeColor=none;strokeWidth=2;spacing=12;align=left;spacing=0;">
