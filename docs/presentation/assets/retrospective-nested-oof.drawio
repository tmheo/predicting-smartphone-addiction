        </mxCell>
        <mxCell id="12" parent="1" vertex="1" value="&lt;b&gt;2. 조합 확정&lt;/b&gt;&lt;br&gt;&lt;br&gt;예: A 60% + B 40%&lt;br&gt;비중은 설명용 예시" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Apple SD Gothic Neo;fontSize=25;fontStyle=0;fontColor=#172b4d;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=2;spacing=12;">
          <mxGeometry as="geometry" x="430" y="390" width="340" height="190" />
        </mxCell>
        <mxCell id="13" parent="1" vertex="1" value="&lt;b&gt;3. 3번에 그대로 적용&lt;/b&gt;&lt;br&gt;&lt;br&gt;3번의 OOF 예측을 합침&lt;br&gt;3번 결과로 조합 수정 안 함" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontFamily=Apple SD Gothic Neo;fontSize=24;fontStyle=0;fontColor=#172b4d;fillColor=#fff7ed;strokeColor=#fb923c;strokeWidth=2;spacing=12;">
