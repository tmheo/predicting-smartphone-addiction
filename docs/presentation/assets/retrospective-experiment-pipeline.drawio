  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>
    <mxCell id="title" value="실험 명세 하나를 커밋해 두면 어느 장소에서든 같은 명령으로 실험하고 같은 검수를 거칩니다" style="text;html=1;fontStyle=1;fontSize=24;align=left;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="1500" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="spec" value="실험 명세 (git에 커밋)&#xa;&#xa;설정 파일 하나&#xa;고정 fold와 시드&#xa;잠근 의존성 판본&#xa;소스 커밋 SHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontStyle=1;fontSize=17;" vertex="1" parent="1">
