    <mxCell id="hRun" value="어디서든 같은 네 단계" style="text;html=1;fontStyle=1;fontSize=17;align=center;fontColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="380" height="30" as="geometry"/></mxCell>
    <mxCell id="hBack" value="가져오기" style="text;html=1;fontStyle=1;fontSize=17;align=center;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="1040" y="250" width="260" height="30" as="geometry"/></mxCell>
    <mxCell id="l1" value="Kaggle&#xa;CPU · GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="220" height="120" as="geometry"/></mxCell>
    <mxCell id="l2" value="Vast.ai · Runpod&#xa;빌린 GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="220" height="120" as="geometry"/></mxCell>
    <mxCell id="l3" value="로컬 CPU&#xa;노트북" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="220" height="120" as="geometry"/></mxCell>
    <mxCell id="s1" value="커밋 SHA, 설정 파일 이름, 단계만 적은&#xa;작은 스크립트를 kaggle kernels push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="320" height="120" as="geometry"/></mxCell>
    <mxCell id="s2" value="vastai 명령줄 도구로 매물 검색과 인스턴스 생성&#xa;SSH 표준 스트림으로 입력 전송, SHA-256 대조&#xa;독립 종료 예약 등록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="480" width="320" height="120" as="geometry"/></mxCell>
    <mxCell id="s3" value="바로 실행" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=15;" vertex="1" parent="1"><mxGeometry x="300" y="660" width="320" height="120" as="geometry"/></mxCell>
    <mxCell id="r1" value="git clone 뒤 커밋 SHA 체크아웃&#xa;uv sync --frozen (의존성 잠금 그대로)&#xa;python -m pipeline.run 설정 --stage screen|confirm&#xa;python -m pipeline.bundle export → 실험 기록 묶음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="380" height="120" as="geometry"/></mxCell>
    <mxCell id="r2" value="git clone 뒤 커밋 SHA 체크아웃&#xa;uv sync --frozen (의존성 잠금 그대로)&#xa;python -m pipeline.run 설정 --stage screen|confirm&#xa;python -m pipeline.bundle export → 실험 기록 묶음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="640" y="480" width="380" height="120" as="geometry"/></mxCell>
    <mxCell id="r3" value="같은 커밋, 같은 의존성 잠금에서&#xa;python -m pipeline.run 설정 --stage screen|confirm&#xa;결과는 바로 로컬 MLflow에 기록" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="640" y="660" width="380" height="120" as="geometry"/></mxCell>
    <mxCell id="b1" value="kaggle kernels output으로&#xa;묶음 zip 내려받기" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="300" width="260" height="120" as="geometry"/></mxCell>
    <mxCell id="b2" value="SSH 표준 스트림으로 묶음 회수&#xa;SHA-256 대조&#xa;인스턴스와 저장 공간 삭제&#xa;과금 중지 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1040" y="480" width="260" height="120" as="geometry"/></mxCell>
    <mxCell id="check" value="로컬 검수대&#xa;pipeline.bundle import&#xa;&#xa;입력 데이터 해시 일치&#xa;그 커밋에 그 설정이 있는지&#xa;코드 상태가 깨끗한지&#xa;OOF를 다시 채점해 점수 일치&#xa;&#xa;통과한 실험만 MLflow에&#xa;정상 실험으로 등록&#xa;→ 비교 · 판정 · 앙상블" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1340" y="300" width="240" height="480" as="geometry"/></mxCell>
